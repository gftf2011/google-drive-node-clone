# String de conexão do banco de dados (PostgreSQL).
# Copie este arquivo para .env e ajuste as credenciais.
# Combina com o docker-compose.yml deste repositório.
DATABASE_URL="postgresql://drive:drive@localhost:5432/drive?schema=public"

# Pool de conexões (opcional — valores padrão entre parênteses)
DATABASE_POOL_MAX="10"
DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
DATABASE_POOL_CONNECTION_TIMEOUT_MS="10000"

# Segredo do JWT (mínimo 32 caracteres em produção).
JWT_SECRET="troque-por-um-segredo-forte-de-32-caracteres-ou-mais"
JWT_EXPIRES_IN_SECONDS="3600"

# Servidor
PORT="3333"
HOST="0.0.0.0"

# Ambiente: development | production | test
NODE_ENV="development"

# Armazenamento de objetos (S3). Em dev, aponta para o simulador `floci`
# (docker-compose deste repo). Em produção, deixe STORAGE_ENDPOINT vazio para
# usar o S3 real e forneça credenciais/região reais.
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="gdrive-uploads"
STORAGE_ENDPOINT="http://localhost:4566"
STORAGE_ACCESS_KEY_ID="test"
STORAGE_SECRET_ACCESS_KEY="test"
# Path-style é obrigatório com o floci/LocalStack (em produção use "false").
STORAGE_FORCE_PATH_STYLE="true"
# Validade das URLs pré-assinadas de cada parte, em segundos (15 min).
STORAGE_PRESIGN_EXPIRES_IN_SECONDS="900"
# Cota de armazenamento por usuário, em bytes (default 15 GiB = 16106127360).
STORAGE_USER_QUOTA_BYTES="16106127360"
