# String de conexão do banco de dados (PostgreSQL).
# Copie este arquivo para .env e ajuste as credenciais.
# Combina com o docker-compose.yml deste repositório.
DATABASE_URL="postgresql://drive:drive@localhost:5432/drive?schema=public"

# Pool de conexões (opcional — valores padrão entre parênteses)
DATABASE_POOL_MAX="10"
DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
DATABASE_POOL_CONNECTION_TIMEOUT_MS="10000"

# Segredo do JWT (mínimo 32 caracteres em produção).
JWT_SECRET="troque-por-um-segredo-forte-de-32-caracteres-ou-mais"
JWT_EXPIRES_IN_SECONDS="3600"

# Servidor
PORT="3333"
HOST="0.0.0.0"

# Ambiente: development | production | test
NODE_ENV="development"

# Armazenamento de objetos (S3). Em dev, aponta para o simulador `floci`
# (docker-compose deste repo). Em produção, deixe STORAGE_ENDPOINT vazio para
# usar o S3 real e forneça credenciais/região reais.
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="gdrive-uploads"
STORAGE_ENDPOINT="http://localhost:4566"
STORAGE_ACCESS_KEY_ID="test"
STORAGE_SECRET_ACCESS_KEY="test"
# Path-style é obrigatório com o floci/LocalStack (em produção use "false").
STORAGE_FORCE_PATH_STYLE="true"
# Validade das URLs pré-assinadas de cada parte, em segundos (15 min).
STORAGE_PRESIGN_EXPIRES_IN_SECONDS="900"
# Cota de armazenamento por usuário, em bytes (default 15 GiB = 16106127360).
STORAGE_USER_QUOTA_BYTES="16106127360"

# --- Ingestão de documentos (contexto `rag`) ---
# URLs dos serviços de extração. Em dev, apontam para os containers do
# docker-compose deste repo. O worker roteia por formato: PDF -> Docling,
# Office/HTML/e-mail -> Unstructured, o resto -> Tika (fallback universal).
INGESTION_TIKA_URL="http://localhost:9998"
INGESTION_UNSTRUCTURED_URL="http://localhost:8000"
# Chave de API do Unstructured (opcional na imagem self-hosted; deixe vazio).
INGESTION_UNSTRUCTURED_API_KEY=""
INGESTION_DOCLING_URL="http://localhost:5001"
# Prefixo das chaves dos artefatos extraídos no storage.
INGESTION_EXTRACTED_PREFIX="extracted/"
# Validade da URL assinada entregue ao extrator (o serviço puxa o objeto direto
# do storage). Cobre a extração de documentos grandes. Em segundos (1h).
INGESTION_SOURCE_URL_EXPIRES_IN_SECONDS="3600"
# Quantos documentos o worker reivindica por ciclo.
INGESTION_WORKER_BATCH_SIZE="10"
# Intervalo de sondagem quando a fila está vazia, em ms.
INGESTION_WORKER_POLL_INTERVAL_MS="2000"
# Chunking (estrutura-primeiro + semântico).
INGESTION_CHUNK_MAX_CHARS="1200"
INGESTION_CHUNK_MIN_CHARS="200"
INGESTION_CHUNK_BREAKPOINT_PERCENTILE="90"
# Modelo de embeddings (Transformers.js, in-process; sem chave). A dimensão deve
# casar com a coluna `embedding` de rag_chunks (bge-small = 384). Requer
# `npm i @xenova/transformers`.
INGESTION_EMBEDDING_MODEL="Xenova/bge-small-en-v1.5"
# Enriquecimento por LLM self-hosted (Ollama; sem chave). Resumo, keywords e
# perguntas hipotéticas por chunk. Degrada graciosamente se o LLM estiver fora.
INGESTION_LLM_URL="http://localhost:11434"
INGESTION_LLM_MODEL="llama3.1"
INGESTION_LLM_TIMEOUT_MS="30000"
INGESTION_LLM_MAX_RETRIES="2"
INGESTION_ENRICH_CONCURRENCY="4"
INGESTION_ENRICH_MAX_KEYWORDS="6"
INGESTION_ENRICH_MAX_QUESTIONS="3"
INGESTION_ENRICH_MAX_INPUT_CHARS="4000"
