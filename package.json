{
  "name": "google-drive-node-clone",
  "version": "1.0.0",
  "description": "Clone das funcionalidades do Google Drive em Node.js com TypeScript e Prisma ORM.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main/server.ts",
    "start": "tsx src/main/server.ts",
    "ingest:worker": "tsx src/main/ingestion-worker.ts",
    "ingest:worker:dev": "tsx watch src/main/ingestion-worker.ts",
    "docker:lite": "docker compose up -d",
    "docker:full": "docker compose --profile full up -d",
    "docker:clean": "docker compose --profile full down -v --rmi all --remove-orphans",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects e2e --runInBand",
    "load:many-users-upload": "k6 run load/many-users-upload.load.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gftf2011/google-drive-node-clone.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gftf2011/google-drive-node-clone/issues"
  },
  "homepage": "https://github.com/gftf2011/google-drive-node-clone#readme",
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  }
}
